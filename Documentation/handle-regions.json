      "space": "handle"
    },
    {
      "name": "kernel objects",
      "header": "runtime/sa2_imports.c",
      "base": "SA2_HANDLE_BASE",
      "stride": "SA2_HANDLE_STRIDE",
      "count": "SA2_HANDLE_MAX",
      "space": "handle",
      "note": "sa2_imports.c owns this one and defines its base, stride and count there rather than in a header. Until 2026-09-23 they were declared as the literals 16 and 4096, 0x10000 bytes, while the code's region was 64 rows of 0x1000, 0x40000 bytes; the rule-5 review found the mismatch when the code's count was raised to 4096 (0x1000000 bytes), and the constants are now read from the code."
    },
    {
      "name": "synthetic COM interfaces",
      "header": "runtime/sa2_iface.h",
      "base": "SA2_IFACE_BASE",
