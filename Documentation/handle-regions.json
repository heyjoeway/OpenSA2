    {
      "name": "HFONT and GDI objects",
      "header": "runtime/sa2_gdi.h",
      "base": "SA2_GDI_HFONT_BASE",
      "stride": "SA2_GDI_TOKEN_STRIDE",
      "count": "SA2_GDI_MAX_TOKENS",
      "space": "handle",
      "note": "sa2_gdi.c deliberately reuses sa2_window.h's HDC and HBRUSH kinds rather than minting its own, so this is the only region it owns."
    },
    {
      "name": "HMONITOR",
      "header": "runtime/sa2_d3d9.h",
      "base": "SA2_D3D9_HMONITOR_BASE",
      "stride": 16,
