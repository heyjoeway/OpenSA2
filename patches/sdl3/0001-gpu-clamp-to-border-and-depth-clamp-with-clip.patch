+static bool VULKAN_INTERNAL_SupportsDepthClipEnable(
+    VulkanRenderer *renderer,
+    VulkanFeatures *features)
+{
+    PFN_vkGetPhysicalDeviceFeatures2 getFeatures2 = NULL;
+    VkPhysicalDeviceDepthClipEnableFeaturesEXT depthClipFeatures;
+    VkPhysicalDeviceFeatures2 featureList;
+
+    if (!renderer->supports.EXT_depth_clip_enable || !features->desiredVulkan10DeviceFeatures.depthClamp) {
+        return false;
+    }
+
+    // vkGetPhysicalDeviceFeatures2 is core only on a 1.1 instance; a 1.0 instance needs the KHR alias
+    if (features->usesCustomVulkanOptions && VK_API_VERSION_MINOR(features->desiredApiVersion) > 0 &&
+        VK_API_VERSION_MINOR(renderer->physicalDeviceProperties.properties.apiVersion) > 0) {
+        getFeatures2 = renderer->vkGetPhysicalDeviceFeatures2;
+    } else if (renderer->supportsPhysicalDeviceProperties2) {
+        getFeatures2 = renderer->vkGetPhysicalDeviceFeatures2KHR;
+    }
+    if (getFeatures2 == NULL) {
+        return false;
+    }
+
+    SDL_zero(depthClipFeatures);
+    depthClipFeatures.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DEPTH_CLIP_ENABLE_FEATURES_EXT;
+    SDL_zero(featureList);
+    featureList.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+    featureList.pNext = &depthClipFeatures;
+    getFeatures2(renderer->physicalDevice, &featureList);
+
+    return featureList.features.depthClamp && depthClipFeatures.depthClipEnable;
+}
